# Example environment variables for JigsawVerse
# Copy this file to .env.local and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Creation gate only. Leave false until every Sprint 1 staging gate passes.
VITE_AUTHORITATIVE_MULTIPLAYER_V2=false
