# Example environment variables for JigsawVerse
# Copy this file to .env.local and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Experimental solo Assemble 3D view. Remains disabled unless explicitly enabled.
# Only supports 5x5 solo practice and is not a ranked/multiplayer release.
VITE_ENABLE_LIVING_ATLAS_SOLO_3D=false
